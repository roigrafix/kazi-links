# Notification Service Configuration
# Copy this file to .env.local and add your actual credentials

# SendGrid Configuration (for email delivery)
VITE_SENDGRID_API_KEY=your_sendgrid_api_key_here

# Twilio Configuration (for SMS delivery)
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
VITE_TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Example values:
# VITE_SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_TWILIO_PHONE_NUMBER=+1234567890