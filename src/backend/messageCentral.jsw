import { getSecret } from 'wix-secrets-backend';
import { fetch } from 'wix-fetch';
import { contacts, triggeredEmails } from 'wix-crm-backend';

const BASE_URL = 'https://cpaas.messagecentral.com';

async function getAuthToken() {
    const customerId = await getSecret('MC_CUSTOMER_ID');
    const password = await getSecret('MC_PASSWORD');
    const email = await getSecret('MC_EMAIL');
    const base64Key = Buffer.from(password).toString('base64');
    const url = `${BASE_URL}/auth/v1/authentication/token?customerId=${customerId}&key=${base64Key}&scope=NEW&email=${email}`;
    const response = await fetch(url, { method: 'GET' });
    const data = await response.json();
    return data.token;
}

export async function sendOTP(mobileNumber, countryCode = '91') {
    try {
        const authToken = await getAuthToken();
        const customerId = await getSecret('MC_CUSTOMER_ID');
        const sendUrl = `${BASE_URL}/verification/v3/send?countryCode=${countryCode}&mobileNumber=${mobileNumber}&flowType=SMS&customerId=${customerId}`;
        const response = await fetch(sendUrl, {
            method: 'POST',
            headers: { 'authToken': authToken, 'Content-Type': 'application/json' }
        });

        // Prevention for "Invalid JSON" error: check status before parsing
        if (!response.ok) {
            const errorText = await response.text();
            console.error("Message Central Error:", errorText);
            return { success: false, message: `Status ${response.status}: ${errorText}` };
        }
        return await response.json();
    } catch (err) {
        return { success: false, message: err.message };
    }
}

export async function verifyOTP(mobileNumber, otpCode, verificationId) {
    try {
        const authToken = await getAuthToken();
        const customerId = await getSecret('MC_CUSTOMER_ID');
        const verifyUrl = `${BASE_URL}/verification/v3/validateOtp?customerId=${customerId}&verificationId=${verificationId}&code=${otpCode}&mobileNumber=${mobileNumber}&countryCode=91`;
        const response = await fetch(verifyUrl, {
            method: 'GET',
            headers: { 'authToken': authToken, 'Content-Type': 'application/json' }
        });
        const result = await response.json();

        if (result.responseCode === 200 && result.data.verificationStatus === 'VERIFIED') {
            const formattedPhone = `+${mobileNumber}`;
            // CRM and Email logic
            const contactResult = await contacts.queryContacts().eq('phone', formattedPhone).find();
            let contactId = contactResult.items.length > 0 ? contactResult.items[0]._id : (await contacts.createContact({phone: formattedPhone}))._id;
            await triggeredEmails.emailContact('VerificationSuccess', contactId, { variables: { phoneNumber: formattedPhone } });
            return { success: true, valid: true };
        }
        return { success: false, message: result.message };
    } catch (err) {
        return { success: false, message: err.message };
    }
}
